# Me-Mex backend — copy to backend/.env

MONGO_URI=mongodb://localhost:27017
DB_NAME=me-mex

# Colab inference gateway (one cloudflared URL — code adds /v1, /stt, /tts)
COLAB_INFERENCE_BASE_URL=http://localhost:7860
LLM_MODEL_NAME=mistralai/Ministral-3-8B-Reasoning-2512
LLM_TIMEOUT=180
# Agent runtime: stub/mock in CI; live for Colab
CHAT_LLM_MODE=stub
DECISION_SCORER_MODE=mock

# Local LiveKit (Docker livekit-server on Mac — not Colab)
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Passage packing + completion caps (optional overrides)
# LLM_MODEL_MAX_LEN=12288
# LLM_COMPLETION_MAX_TOKENS=2048
# CONSOLIDATION_MAX_TOKENS=3072
# CHAT_COMPLETION_MAX_TOKENS=1024
# Voice plane 1 Conversation stream (live Colab); workers draft detail in dock
# VOICE_FOREGROUND_MAX_TOKENS=220
# INGEST_PASSAGE_MAX_CHARS=
# INGEST_EXTRACTION_CONCURRENCY=4

# RetrievalWorker BFS
# MAX_TRAVERSAL_DEPTH=5
# RETRIEVAL_TRAVERSAL_TOP_K=3
# DEGREE_THRESHOLD=7

# HTTPX_MAX_CONNECTIONS=20
# CHECKPOINTS_DIR=backend/data/checkpoints
# DECISION_TRAINING_DIR=backend/data/decision_training
# Live session traces for eval / optional reranker refresh (Phase 4)
# DECISION_TRACE_DIR=backend/logs/decision_traces
# DECISION_TRACE_ENABLED=true
