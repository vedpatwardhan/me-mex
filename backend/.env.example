# Me-Mex backend — copy to .env and adjust

COLAB_VLLM_URL=http://localhost:8000/v1
LLM_MODEL_NAME=mistralai/Ministral-3-8B-Reasoning-2512
LLM_TIMEOUT=180

# vLLM context (match Colab: max-model-len 12288, max-num-seqs 8, max-num-batched-tokens 8192)
LLM_MODEL_MAX_LEN=12288
# LLM_COMPLETION_RESERVE_TOKENS=2048
# LLM_PROMPT_OVERHEAD_TOKENS=4000
# LLM_PASSAGE_CHARS_PER_TOKEN=2.9
# LLM_PASSAGE_SAFETY_FACTOR=0.86
# INGEST_EXTRACTION_SUMMARY_MAX_CHARS=2400
# INGEST_PASSAGE_MAX_CHARS=  # unset = derived from LLM_MODEL_MAX_LEN
# TRAVERSAL_INPUT_MAX_CHARS=9000
# GENESIS_TRAVERSAL_MAX_CHARS=1500

# Ingestion throughput (keep INGEST_EXTRACTION_CONCURRENCY <= max-num-seqs)
INGEST_EXTRACTION_CONCURRENCY=4
INGEST_JSON_COMPACT=true
INGEST_USE_ROLLING_SUMMARY=true
CHAT_SUMMARY_MAX_CHARS=4000
# LLM_COMPLETION_MAX_TOKENS=2048
# CONSOLIDATION_MAX_TOKENS=2048
# INGESTION_SUMMARY_MAX_TOKENS=512
# CHAT_COMPLETION_MAX_TOKENS=1024
# CONVERSATION_INCLUDE_EVENT_QUEUE=false
CHAT_SUMMARY_REFRESH_MIN_TURNS=4
INGEST_STRUCTURED_CHAT_HISTORY_TURNS=2
# Ingest traversal (code defaults: max_depth 3 when unset, top_k 1)
# INGEST_TRAVERSAL_MAX_DEPTH=3
# INGEST_TRAVERSAL_TOP_K=1
# RETRIEVAL_TRAVERSAL_MAX_DEPTH=5
# RETRIEVAL_TRAVERSAL_TOP_K=3
# RETRIEVAL_CONTEXT_MAX_CHARS=48000
# RETRIEVAL_RELEVANCE_FILTER=true

HTTPX_MAX_CONNECTIONS=20
HTTPX_MAX_KEEPALIVE=10

# Stage completion caps (optional overrides; defaults live in config.py)
# REORG_PARTITION_MAX_TOKENS=3072
# COLLECTIVE_LINKING_MAX_TOKENS=2048
# SUBGRAPH_EXPANSION_MAX_TOKENS=512
# GENERALIZATION_MAX_TOKENS=1536
REORG_PARTITION_ENABLE_REASONING=false

DEGREE_THRESHOLD=7
MAX_TRAVERSAL_DEPTH=5

# --- Me-Mex v2 (Phase 1+) ---
MONGO_URI=mongodb://localhost:27017
DB_NAME=me-mex
ME_MEX_V2=1
V2_DISABLE_V1_AUTOPATHS=1
LORA_ADAPTER_ID=decision-lora
# CHECKPOINTS_DIR=backend/data/checkpoints
# DECISION_TRAINING_DIR=backend/data/decision_training
