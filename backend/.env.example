# Me-Mex backend — copy to backend/.env

MONGO_URI=mongodb://localhost:27017
DB_NAME=me-mex

# Colab inference gateway (cloudflared → me_mex_inference_stack.ipynb §7, not raw vLLM :8000)
COLAB_VLLM_URL=http://localhost:7860/v1
LLM_MODEL_NAME=mistralai/Ministral-3-8B-Reasoning-2512
LLM_TIMEOUT=180
# Agent runtime: stub/mock in CI; live for Colab
CHAT_LLM_MODE=stub
DECISION_SCORER_MODE=mock

# Phase 2 voice: same trycloudflare host as above, without /v1 (see colab/TOPOLOGY.md)
# COLAB_SPEECH_BASE_URL=https://YOUR_SUBDOMAIN.trycloudflare.com

# Passage packing + completion caps (optional overrides)
# LLM_MODEL_MAX_LEN=12288
# LLM_COMPLETION_MAX_TOKENS=2048
# CONSOLIDATION_MAX_TOKENS=3072
# CHAT_COMPLETION_MAX_TOKENS=1024
# INGEST_PASSAGE_MAX_CHARS=
# INGEST_EXTRACTION_CONCURRENCY=4

# RetrievalWorker BFS
# MAX_TRAVERSAL_DEPTH=5
# RETRIEVAL_TRAVERSAL_TOP_K=3
# DEGREE_THRESHOLD=7

# HTTPX_MAX_CONNECTIONS=20
# CHECKPOINTS_DIR=backend/data/checkpoints
# DECISION_TRAINING_DIR=backend/data/decision_training