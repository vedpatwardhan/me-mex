ME_MEX_BACKEND_URL=http://127.0.0.1:8000
COLAB_INFERENCE_BASE_URL=https://YOUR_SUBDOMAIN.trycloudflare.com

# Push-to-talk: STT runs when you mute (not on silence). Audio buffered while unmuted.
# VOICE_VAD=silero  # optional preload; capture uses PushToTalkBuffer
# VOICE_MIN_UTTERANCE_MS=400
# VOICE_MIN_SILENCE_MS=550
# VOICE_MAX_UTTERANCE_MS=60000
# Legacy RMS fallback for tests: VOICE_VAD=rms
# VOICE_SILENCE_RMS=0.008
# VOICE_END_SILENCE_MS=1500

# Pipelined TTS while conversation tokens stream (sentence chunks to Colab)
# VOICE_TTS_PIPELINED=true
# VOICE_TTS_SEGMENT_MAX_CHARS=180
# VOICE_TTS_SEGMENT_MIN_CHARS=12

# Data channel types: context_update, approve, cancel, agent_turn, speech_wav (base64)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
